# Normalizacion de line endings.
# Los .sh y units de systemd se ejecutan en la VM Linux: SIEMPRE LF, aunque se
# editen desde Windows (CRLF en un script bash = "\r: command not found").
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.py text
*.md text
*.json text
# Generated visual/report artifacts: retain in Git, exclude from GitHub language statistics.
graphify-out/** linguist-generated=true
reporting/btc_cycle_phase_audit.html linguist-generated=true
# Binarios
*.xlsx binary
*.db binary
