[Unit]
Description=MatiTradingBot certified V7 OKX Demo candidate (inactive by default)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PYTHON__ __APP_DIR__/tools/v7_certified_demo_service.py --run --config __CONFIG_PATH__ --state __STATE_PATH__ --journal __JOURNAL_PATH__ --evidence __EVIDENCE_PATH__ --reports __REPORT_PATH__
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=350M

[Install]
WantedBy=multi-user.target
